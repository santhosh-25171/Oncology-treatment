{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScenarioAuditSchema",
  "description": "Validation schema for individual scenario audit records generated by the Evaluation Engineer",
  "type": "object",
  "required": [
    "scenario_id",
    "evaluation_status",
    "schema_validation",
    "provenance_validation",
    "blind_spot_audit",
    "genomic_consistency",
    "clinical_consistency",
    "resistance_stress_audit",
    "decision_stress_score",
    "realism_score",
    "stress_dimensions",
    "flags",
    "audit_timestamp"
  ],
  "properties": {
    "scenario_id": { "type": "string" },
    "evaluation_status": { "type": "string", "enum": ["PASS", "REVIEW", "FAIL"] },
    "schema_validation": {
      "type": "object",
      "required": ["valid", "issues"],
      "properties": {
        "valid": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance_validation": {
      "type": "object",
      "required": ["valid", "issues", "has_reference_sources", "has_blind_spot_source", "has_timestamp", "has_seed"],
      "properties": {
        "valid": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } },
        "has_reference_sources": { "type": "boolean" },
        "has_blind_spot_source": { "type": "boolean" },
        "has_timestamp": { "type": "boolean" },
        "has_seed": { "type": "boolean" }
      }
    },
    "blind_spot_audit": {
      "type": "object",
      "required": [
        "blind_spot_targeted",
        "blind_spot_supported",
        "blind_spot_type",
        "blind_spot_evidence",
        "blind_spot_coverage_score"
      ],
      "properties": {
        "blind_spot_targeted": { "type": "string" },
        "blind_spot_supported": { "type": "boolean" },
        "blind_spot_type": { "type": "string" },
        "blind_spot_evidence": { "type": "string" },
        "blind_spot_coverage_score": { "type": "number", "minimum": 0.0, "maximum": 5.0 }
      }
    },
    "genomic_consistency": {
      "type": "object",
      "required": ["valid", "classifications", "issues"],
      "properties": {
        "valid": { "type": "boolean" },
        "classifications": { "type": "object" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "clinical_consistency": {
      "type": "object",
      "required": ["valid", "issues"],
      "properties": {
        "valid": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resistance_stress_audit": {
      "type": "object",
      "required": ["identified_dimensions", "dimension_count", "resistance_mechanism_profile"],
      "properties": {
        "identified_dimensions": { "type": "array", "items": { "type": "string" } },
        "dimension_count": { "type": "integer" },
        "resistance_mechanism_profile": { "type": "string" }
      }
    },
    "decision_stress_score": {
      "type": "object",
      "required": [
        "genomic_complexity",
        "evidence_uncertainty",
        "resistance_complexity",
        "conflicting_signals",
        "decision_ambiguity",
        "overall_stress_score",
        "stress_level"
      ],
      "properties": {
        "genomic_complexity": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "evidence_uncertainty": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "resistance_complexity": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "conflicting_signals": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "decision_ambiguity": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "overall_stress_score": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "stress_level": { "type": "string", "enum": ["weak", "low", "moderate", "strong", "extreme"] }
      }
    },
    "realism_score": {
      "type": "object",
      "required": [
        "reference_data_consistency",
        "evidence_consistency",
        "clinical_consistency",
        "provenance_quality",
        "uncertainty_handling",
        "overall_realism_score"
      ],
      "properties": {
        "reference_data_consistency": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "evidence_consistency": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "clinical_consistency": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "provenance_quality": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "uncertainty_handling": { "type": "number", "minimum": 0.0, "maximum": 5.0 },
        "overall_realism_score": { "type": "number", "minimum": 0.0, "maximum": 5.0 }
      }
    },
    "stress_dimensions": { "type": "array", "items": { "type": "string" } },
    "flags": { "type": "array", "items": { "type": "string" } },
    "audit_timestamp": { "type": "string" }
  }
}

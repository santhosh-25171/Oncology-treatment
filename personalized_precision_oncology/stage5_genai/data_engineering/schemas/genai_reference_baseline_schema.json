{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenAIReferenceBaselineSchema",
  "description": "Validation schema for GenAI Reference Baseline JSONL records consumed by Stage 5 SyntheticCaseGenerator",
  "type": "object",
  "required": [
    "reference_id",
    "source_name",
    "source_type",
    "data_domain",
    "evidence_status",
    "provenance"
  ],
  "properties": {
    "reference_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": [
        "patient_cohort",
        "epidemiology",
        "variant_evidence",
        "biomarker_evidence",
        "literature_reference"
      ]
    },
    "source_record_id": { "type": "string" },
    "data_domain": {
      "type": "string",
      "enum": [
        "clinical",
        "genomic",
        "epidemiology",
        "resistance",
        "biomarker",
        "treatment_response"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "prospective_clinical_cohort",
        "retrospective_surgical_cohort",
        "population_registry",
        "curated_clinical_evidence",
        "published_guideline_benchmark"
      ]
    },
    "data_type": { "type": "string", "minLength": 1 },
    "cancer_type": { "type": "string", "minLength": 1 },
    "stage_distribution": {
      "type": ["object", "string"]
    },
    "age_distribution": {
      "type": ["object", "string"]
    },
    "sex_distribution": {
      "type": ["object", "string"]
    },
    "mutation_patterns": {
      "type": ["array", "string"]
    },
    "mutation_cooccurrence": {
      "type": ["array", "string"]
    },
    "biomarker_distributions": {
      "type": ["object", "string"]
    },
    "resistance_patterns": {
      "type": ["array", "string"]
    },
    "provenance": {
      "type": "object",
      "required": ["source_name", "dataset", "access_date", "reference"],
      "properties": {
        "source_name": { "type": "string" },
        "source_dataset": { "type": "string" },
        "dataset": { "type": "string" },
        "source_study": { "type": "string" },
        "source_database": { "type": "string" },
        "source_publication": { "type": "string" },
        "access_date": { "type": "string" },
        "access_information": { "type": "string" },
        "reference": { "type": "string" },
        "source_url": { "type": "string" },
        "license": { "type": "string" },
        "record_count": { "type": ["integer", "string"] }
      }
    }
  }
}

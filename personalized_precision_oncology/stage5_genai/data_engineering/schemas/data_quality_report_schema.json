{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataQualityReportSchema",
  "description": "Validation schema for automated oncology data quality and integrity report",
  "type": "object",
  "required": [
    "original_row_count",
    "original_column_count",
    "cleaned_row_count",
    "removed_duplicate_count",
    "invalid_record_count",
    "missing_value_summary",
    "validation_errors",
    "warnings",
    "retained_records",
    "source_information",
    "final_validation_status"
  ],
  "properties": {
    "original_row_count": { "type": "integer" },
    "original_column_count": { "type": "integer" },
    "cleaned_row_count": { "type": "integer" },
    "removed_duplicate_count": { "type": "integer" },
    "invalid_record_count": { "type": "integer" },
    "missing_value_summary": { "type": "object" },
    "validation_errors": { "type": "array" },
    "warnings": { "type": "array" },
    "retained_records": { "type": "integer" },
    "source_information": { "type": "object" },
    "final_validation_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "WARNING"]
    },
    "report_metadata": { "type": "object" },
    "numeric_range_validation": { "type": "object" },
    "categorical_consistency_audit": { "type": "object" },
    "rare_mutation_preservation_audit": { "type": "object" }
  }
}
